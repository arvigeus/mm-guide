---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PlaceArt from '../../components/PlaceArt.astro';
import { places } from '../../data/places';
export function getStaticPaths() { return places.map(place => ({ params: { slug: place.slug }, props: { place } })); }
const { place } = Astro.props;
const mapLink = `https://www.openstreetmap.org/?mlat=${place.coordinates.lat}&mlon=${place.coordinates.lng}#map=16/${place.coordinates.lat}/${place.coordinates.lng}`;
---
<Layout title={`${place.name} — A little Ha Long`} description={place.description}>
  <a class="back-link" href="/"><Icon name="back" size={18} />Back to discoveries</a>
  <section class="detail-header"><p class="eyebrow">{place.category} · {place.area}</p><h1>{place.name}</h1><p class="vietnamese-name">{place.vietnamese}</p><p class="detail-subtitle">{place.description}</p></section>
  <div class="detail-art"><PlaceArt place={place} large /><span>{['bay', 'beach'].includes(place.art) ? 'A glimpse of Ha Long Bay · illustrative photography' : 'Illustration · venue photography coming later'}</span></div>
  <div class="detail-grid"><section class="detail-story"><p class="eyebrow">A LITTLE ABOUT THIS PLACE</p><h2>Let’s explore.</h2><p>{place.story}</p><div class="tip-box"><Icon name="compass" size={25} /><div><h3>A little tip</h3><p>{place.tip}</p></div></div></section><aside class="visit-panel"><h2>Your next little adventure</h2><div><Icon name="pin" /><span><small>WHERE</small>{place.area}</span></div><div><Icon name="boat" /><span><small>GOOD TO KNOW</small>{place.access}</span></div><div><Icon name="compass" /><span><small>TAKE YOUR TIME</small>{place.visit}</span></div><a class="button primary" href={mapLink} target="_blank" rel="noopener noreferrer">Open in OpenStreetMap<Icon name="arrow" size={18} /></a><p>Approximate location. Check access, opening times, and any tickets before you go. For islands, arrange a boat itinerary.</p></aside></div>
  <p class="sample-note">Prototype guide content · no live availability, booking, or verified entrance coordinates.</p>
</Layout>
