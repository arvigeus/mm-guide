---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IMap from '../components/imap/IMap.astro';
import PlaceArt from '../components/PlaceArt.astro';
import HeritageChoice from '../components/HeritageChoice.astro';
import { places, demoLocation } from '../data/places';
import { distanceKm, findPlaces, formatDistance } from '../lib/explore';
const initialPlaces = findPlaces(places, '', 'All', demoLocation);
---
<Layout wide overlayHeader>
  <section class="hero" aria-labelledby="hero-heading">
    <svg class="hero-tone-map" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="hero-shadow-detail" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="gamma" amplitude="1" exponent="0.86" offset="0" />
            <feFuncG type="gamma" amplitude="1" exponent="0.86" offset="0" />
            <feFuncB type="gamma" amplitude="1" exponent="0.86" offset="0" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <img class="hero-image" src="/images/mev9zaoqveug1.jpeg" alt="Người đội nón lá giữa những bó hương đỏ và vàng xếp thành vòng" width="3000" height="2000" fetchpriority="high" loading="eager" />
    <div class="hero-shade"></div>
    <div class="hero-content shell">
      <div class="hero-copy">
      <p class="eyebrow">KHÁM PHÁ THEO CÁCH CỦA BẠN</p>
      <h1 id="hero-heading"><span>Hà Nội</span><span>của riêng bạn.</span></h1>
      <p class="hero-description">Từ những góc phố quen đến những câu chuyện chưa kể. Khám phá một Hà Nội mang dấu ấn của riêng bạn.</p>
      <a class="button hero-button" href="#explore">Khám phá Hà Nội <Icon name="arrow" size={21} /></a>
      </div>
    </div>
    <div class="hero-bottom shell"><span>Sắc hương · Nét đẹp làng nghề</span><a href="#explore" aria-label="Cuộn đến phần khám phá">Khám phá thêm <span aria-hidden="true">↓</span></a></div>
  </section>

  <HeritageChoice />

  <div id="explore" class="explore-section">
    <div class="shell">
      <IMap idPrefix="home-imap" searchId="search" filtersId="experiences" headerSelector=".site-header" showFullLink
        resultsId="results" nearbyId="nearby" resultCountId="result-count" emptyStateId="empty-state" resetFiltersId="reset-filters" />

      <section class="results-section" aria-labelledby="results-heading">
        <div class="section-heading results-heading">
          <div><p class="eyebrow">THEO BƯỚC TÒ MÒ</p><h2 id="results-heading">Bắt đầu từ<br />những nơi này.</h2><p id="result-count" role="status">{initialPlaces.length} địa điểm, gần nhất trước</p></div>
          <label class="nearby-toggle"><input type="checkbox" id="nearby" /><span>Trong bán kính 10 km</span></label>
        </div>
        <div id="results" class="results-grid">
          {initialPlaces.map(place => <article class="place-card" data-card={place.slug}>
            <a class="card-image-link" href={`/places/${place.slug}/`} aria-label={`Khám phá ${place.name}`}><PlaceArt place={place} /><span class="card-category">{place.category}</span><span class="image-arrow" aria-hidden="true"><Icon name="arrow" size={24} /></span></a>
            <div class="card-body">
              <p class="card-area"><Icon name="pin" size={14} />{place.area}<span class="card-distance" data-distance={place.slug}>Cách {formatDistance(distanceKm(demoLocation, place.coordinates))}</span></p>
              <h3><a href={`/places/${place.slug}/`}>{place.name}</a></h3>
              <p class="card-description">{place.description}</p>
              <div class="card-bottom"><span>{place.access}</span><a class="card-action" href={`/places/${place.slug}/`} aria-label={`Xem ${place.name}`}><Icon name="arrow" size={21} /></a></div>
            </div>
          </article>)}
        </div>
        <div id="empty-state" class="empty-state" hidden><Icon name="compass" size={40} /><h3>Thử khám phá xa hơn nhé?</h3><p>Không có địa điểm phù hợp. Hãy đổi từ khóa hoặc bỏ giới hạn khoảng cách.</p><button id="reset-filters" type="button" class="button primary">Hiện tất cả địa điểm</button></div>
        <p class="sample-note">6 địa điểm tuyển chọn cho bản mẫu. Tọa độ gần đúng; khoảng cách tính theo đường chim bay, không phải quãng đường hay thời gian di chuyển.</p>
      </section>
    </div>
  </div>

  <div class="editorial-topics shell">
    <section id="food" aria-labelledby="food-heading"><h2 id="food-heading">Ẩm thực</h2><p>Khám phá hương vị Hà Nội trong những lần dạo phố. Nội dung gợi ý quán ăn đang được chuẩn bị.</p></section>
    <section id="events" aria-labelledby="events-heading"><h2 id="events-heading">Sự kiện</h2><p>Lịch sự kiện đang được chuẩn bị. Hãy kiểm tra thông tin từ đơn vị tổ chức trước khi lên kế hoạch.</p></section>
    <section id="local-tips" aria-labelledby="tips-heading"><h2 id="tips-heading">Thổ địa mách bạn</h2><p>Đi thật chậm, chọn một góc phố và đọc những lời nhắn nhỏ trong từng trang địa điểm trước khi đến.</p><a href="#results-heading">Xem gợi ý địa điểm →</a></section>
  </div>

  <aside class="closing-note">
    <div class="shell"><p class="eyebrow">My Hanoi</p><h2>Mỗi góc phố đều có<br />một câu chuyện.</h2><p>Chọn một nơi. Đi thật chậm. Khám phá Hà Nội theo cách của bạn.</p><a class="button closing-button" href="#explore">Tìm góc Hà Nội của bạn <Icon name="arrow" size={21} /></a><span class="closing-destination">HÀ NỘI, VIỆT NAM</span></div>
  </aside>
</Layout>
<style>
  /* Local Explorer canvas; do not recolor map tiles, panels or cards. */
  #explore { background: #FFFFFF; }
</style>
